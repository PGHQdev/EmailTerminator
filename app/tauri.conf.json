{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmailTerminator",
  "identifier": "com.emailterminator.app",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmailTerminator",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
